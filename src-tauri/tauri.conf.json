{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANQL",
  "version": "0.3.1",
  "identifier": "ANQL",
  "build": {
  "beforeDevCommand": "npm run dev",
  "devUrl": "http://localhost:1420",
  "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "",
        "width": 800,
        "height": 600,
        "maximized": true,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "os": {
      "all": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}